{
  "description": "Comeback adaptive supervision backed by Sibyl Memory.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/python\" -m comeback.hook",
            "timeout": 30,
            "statusMessage": "Recalling intervention history",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/python\" -m comeback.hook",
            "timeout": 30,
            "statusMessage": "Checking earned autonomy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/python\" -m comeback.hook",
            "timeout": 30,
            "statusMessage": "Recording supervision evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/python\" -m comeback.hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

